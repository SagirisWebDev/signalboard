# Dependencies (installed at build time)
/vendor/
/node_modules/

# Note: /build/ (compiled block assets) IS committed so the plugin works on a
# fresh clone / on wp.org without a Node build step.

# Local / editor
.DS_Store
.env
.env.*
/.idea/
/.vscode/
/.claude/

# Local-only harness config (not shipped with the repo)
/.swd-harness/

# Logs
*.log

# Test artifacts
/.phpunit.result.cache
/test-results/
/playwright-report/
/.last-run.json
