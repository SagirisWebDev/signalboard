<?xml version="1.0"?>
<ruleset name="Signalboard">
	<description>Coding standards for the Signalboard plugin.</description>

	<file>signalboard.php</file>
	<file>src</file>
	<file>tests</file>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>
	<arg name="parallel" value="8"/>

	<config name="minimum_wp_version" value="6.4"/>
	<config name="testVersion" value="8.1-"/>

	<rule ref="WordPress-Extra">
		<!-- PSR-4 class files use PascalCase, not WordPress file naming. -->
		<exclude name="WordPress.Files.FileName"/>
	</rule>

	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="signalboard"/>
				<element value="SIGNALBOARD"/>
				<element value="Sagiris\Signalboard"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="signalboard"/>
			</property>
		</properties>
	</rule>

	<!-- Tests define global helper functions and need looser rules. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
</ruleset>
