{
    "name": "sagiris/signalboard",
    "description": "Headless-ready WordPress feature-voting, feedback & roadmap plugin exposed over REST API and WPGraphQL.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Sagiris",
            "homepage": "https://sagirisdev.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "firebase/php-jwt": "^6.10"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "yoast/phpunit-polyfills": "^2.0",
        "wp-coding-standards/wpcs": "^3.1",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Sagiris\\Signalboard\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sagiris\\Signalboard\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "phpcs",
        "lint:fix": "phpcbf",
        "test": "phpunit"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "platform": {
            "php": "8.1"
        },
        "sort-packages": true
    }
}
